# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# Optional: OpenAI (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-your-api-key-here
# LLM_MODEL=gpt-4o

# Optional: Ollama local (set LLM_PROVIDER=ollama)
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=llama3

# Embedding Configuration
EMBEDDING_MODEL=jinaai/jina-embeddings-v3
# Optional: remote OpenAI-compatible embedding API (leave blank to use local sentence-transformers)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# RAG Configuration
RAG_TOP_K=20

# Reranker Configuration
RERANKER_ENABLED=true
RERANK_BASE_URL=https://api.jina.ai/v1/rerank
RERANK_API_KEY=your-api-key-here
RERANK_MODEL=jina-reranker-v2-code
RERANKER_TOP_N=10

# Evaluation Configuration
EVAL_DATASET=princeton-nlp/SWE-bench_Lite

# Logging
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=10

# Graph RAG (Code Property Graph — auto-built per repo, no external deps)
ENABLE_GRAPH_RAG=true

# Neo4j Graph Database (optional — persistent graph storage)
# Enable to store/query code graphs in Neo4j instead of in-memory
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
# Quick start: docker run -d --name neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:latest
ENABLE_REPO_SKELETON=true
REPO_SKELETON_MAX_FILES=180
RERANK_MAX_CHARS_PER_FILE=12000

# Parallelism
MAX_PARALLEL_TOOLS=8
MAX_PARALLEL_EVALS=4

# Self-reflection (retry Navigation+Confirmation if top confidence is low)
REFLECTION_MAX_ROUNDS=1
REFLECTION_CONF_THRESHOLD=0.5

# Best-of-N: temperature when LLM_TEMPERATURE is 0 and multi-pass > 1
MULTI_PASS_TEMPERATURE=0.3
