# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# Optional: OpenAI (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-your-api-key-here
# LLM_MODEL=gpt-4o

# Optional: Ollama local (set LLM_PROVIDER=ollama)
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=llama3

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# RAG Configuration
RAG_TOP_K=20

# Evaluation Configuration
EVAL_DATASET=princeton-nlp/SWE-bench_Lite

# Logging
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=10

# Graph RAG (Code Property Graph — auto-built per repo, no external deps)
ENABLE_GRAPH_RAG=true

# Parallelism
MAX_PARALLEL_TOOLS=8
MAX_PARALLEL_EVALS=4
