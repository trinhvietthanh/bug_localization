# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# Optional: OpenAI (set LLM_PROVIDER=openai to use)
# OPENAI_API_KEY=sk-your-api-key-here
# LLM_MODEL=gpt-4o

# Optional: Ollama local (set LLM_PROVIDER=ollama)
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=llama3

# Embedding Configuration
EMBEDDING_MODEL=jinaai/jina-embeddings-v3
# Optional: remote OpenAI-compatible embedding API (leave blank to use local sentence-transformers)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# RAG Configuration
RAG_TOP_K=20

# Reranker Configuration
RERANKER_ENABLED=true
RERANK_BASE_URL=https://api.jina.ai/v1/rerank
RERANK_API_KEY=your-api-key-here
RERANK_MODEL=jina-reranker-v2-code
RERANKER_TOP_N=10

# Evaluation Configuration
EVAL_DATASET=princeton-nlp/SWE-bench_Lite

# Logging
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=10

# Graph RAG (Code Property Graph — auto-built per repo, no external deps)
ENABLE_GRAPH_RAG=true

# Neo4j Graph Database (optional — persistent graph storage)
# Enable to store/query code graphs in Neo4j instead of in-memory
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
# Quick start: docker run -d --name neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:latest
ENABLE_REPO_SKELETON=true
REPO_SKELETON_MAX_FILES=180
RERANK_MAX_CHARS_PER_FILE=12000

# Unified Scorer weights (multi-signal reranking of candidate files)
# Each signal contributes weight * normalised_signal to the file's total score.
SCORE_WEIGHT_LLM=1.0
SCORE_WEIGHT_STACK_TRACE=2.5
SCORE_WEIGHT_ERROR=1.5
SCORE_WEIGHT_MENTIONED=1.2
SCORE_WEIGHT_GRAPH=0.8
SCORE_WEIGHT_SEMANTIC=0.6
SCORE_WEIGHT_METHOD=0.3
SCORE_WEIGHT_GIT_RECENCY=0.5
# Half-life (days) for git-recency decay: score = 0.5 ** (age_days / half_life)
SCORE_GIT_RECENCY_HALFLIFE_DAYS=90
SCORE_TEST_PENALTY=0.5

# Parallelism
MAX_PARALLEL_TOOLS=8
MAX_PARALLEL_EVALS=4

# Self-reflection (retry Navigation+Confirmation if top confidence is low)
REFLECTION_MAX_ROUNDS=1
REFLECTION_CONF_THRESHOLD=0.5

# Best-of-N: temperature when LLM_TEMPERATURE is 0 and multi-pass > 1
MULTI_PASS_TEMPERATURE=0.3

# Minimum size of the final ranked file list. When the confirmed list is
# shorter, it is padded from navigation candidates, stack-trace/mentioned
# files, retrievers, and path-keyword matching so Top-5/Top-10 have room.
MIN_RANKED_FILES=10

# ── E3: Hierarchical narrowing + Listwise rerank (Agentless-style) ──────────
# Stage (a): one LLM call narrows each top-K file to suspect functions/lines
ENABLE_HIERARCHICAL_NARROWING=false
# Stage (b): one listwise LLM call re-orders the top-K files using evidence
# cards. Permutation only — Top-10/recall are unchanged by construction.
ENABLE_LISTWISE_RERANK=false
LISTWISE_RERANK_TOP_K=10
# 2 passes = second call with a different shuffle, merged via RRF (bias check)
LISTWISE_RERANK_PASSES=1

# ── E1: Competing-hypotheses debugging loop (scientific debugging) ──────────
# Counterfactual audit that adds validated configuration/protocol owners before
# symptom-local candidates. Opt-in pending the persistent-failure ablation.
ENABLE_COMPREHENSION_OWNER_CHALLENGE=false
COMPREHENSION_OWNER_MAX_FILES=3
COMPREHENSION_OWNER_MAX_SEARCHES=3

# Comprehension proposes K falsifiable hypotheses; a VerificationAgent gathers
# evidence for/against each; deterministic log-odds tracking updates beliefs.
ENABLE_HYPOTHESIS_LOOP=false
HYPOTHESIS_K=4
HYPOTHESIS_VERIFY_MAX_ITER=6
HYPOTHESIS_FALSIFY_THRESHOLD=0.15
# Skip verification on stack-trace-rich bugs with confident top hypothesis
HYPOTHESIS_FASTPATH_PRIOR=0.85
# UnifiedScorer weight for hypothesis support (negative for falsified files)
SCORE_WEIGHT_HYPOTHESIS=0.8

# ── E2: Priority-guided exploration (OrcaLoca-style) ────────────────────────
# A deterministic priority queue owns the navigation loop; the LLM only
# scores observations with O(1) context. Empty predictions become impossible.
ENABLE_PRIORITY_EXPLORATION=false
EXPLORATION_MAX_ACTIONS=20
# priority = W_LLM*relevance/10 + W_GRAPH/(1+hops) + W_SIGNAL*static_prior
EXPLORATION_W_LLM=0.5
EXPLORATION_W_GRAPH=0.3
EXPLORATION_W_SIGNAL=0.2
# Java CPG is regex-built and noisier — lower graph weight
EXPLORATION_W_GRAPH_JAVA=0.15
EXPLORATION_MIN_PRIORITY=0.15
EXPLORATION_MAX_DEPTH=4
# Run vanilla free-form NavigationAgent when the explorer finds too little
EXPLORATION_FALLBACK_TO_FREEFORM=true
